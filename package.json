{
  "name": "license-plates",
  "version": "0.1.0",
  "description": "Vehicle registration plates by country, starting with Bulgaria: normalise, check, classify and format, with every rule cited to its regulation.",
  "keywords": [
    "license-plate",
    "licence-plate",
    "number-plate",
    "registration-plate",
    "vehicle",
    "bulgaria",
    "bulgarian",
    "регистрационен-номер",
    "мпс"
  ],
  "homepage": "https://github.com/eezkren/license-plates#readme",
  "bugs": {
    "url": "https://github.com/eezkren/license-plates/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eezkren/license-plates.git"
  },
  "license": "MIT",
  "author": "Iskren Ivanov (https://github.com/eezkren)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bg": {
      "types": "./dist/bg/index.d.ts",
      "default": "./dist/bg/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
